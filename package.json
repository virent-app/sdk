{
  "name": "@virent.app/sdk",
  "version": "0.1.2",
  "description": "Virent browser and server-side analytics SDK.",
  "type": "module",
  "license": "Apache-2.0",
  "sideEffects": false,
  "homepage": "https://virent.app",
  "packageManager": "bun@1.3.7",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/virent-app/sdk.git"
  },
  "bugs": {
    "email": "virent.app@gmail.com"
  },
  "keywords": [
    "analytics",
    "ai",
    "llm",
    "crawler",
    "virent"
  ],
  "files": [
    "dist/*.d.mts",
    "dist/**/*.mjs",
    "LICENSE",
    "README.md"
  ],
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./browser": {
      "types": "./dist/browser.d.mts",
      "import": "./dist/browser.mjs",
      "default": "./dist/browser.mjs"
    },
    "./elysia": {
      "types": "./dist/elysia.d.mts",
      "import": "./dist/elysia.mjs",
      "default": "./dist/elysia.mjs"
    },
    "./next": {
      "types": "./dist/next.d.mts",
      "import": "./dist/next.mjs",
      "default": "./dist/next.mjs"
    },
    "./server": {
      "types": "./dist/server.d.mts",
      "import": "./dist/server.mjs",
      "default": "./dist/server.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc --noEmit",
    "pack:dry-run": "npm pack --dry-run",
    "prepack": "bun run build",
    "test": "bun test"
  },
  "peerDependencies": {
    "elysia": "^1.4.28",
    "next": "^16.0.0"
  },
  "peerDependenciesMeta": {
    "elysia": {
      "optional": true
    },
    "next": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/bun": "^1.3.11",
    "elysia": "^1.4.28",
    "next": "^16.2.1",
    "tsdown": "^0.21.5",
    "typescript": "^6.0.2"
  }
}
