{
  "name": "@virent.app/sdk",
  "version": "0.2.0",
  "description": "Virent browser and server-side analytics SDK.",
  "keywords": [
    "analytics",
    "ai",
    "llm",
    "crawler",
    "virent"
  ],
  "homepage": "https://virent.app",
  "bugs": {
    "email": "virent.app@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/virent-app/sdk.git"
  },
  "license": "Apache-2.0",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./browser": {
      "types": "./dist/browser.d.mts",
      "import": "./dist/browser.mjs",
      "default": "./dist/browser.mjs"
    },
    "./next": {
      "types": "./dist/next.d.mts",
      "import": "./dist/next.mjs",
      "default": "./dist/next.mjs"
    },
    "./server": {
      "types": "./dist/server.d.mts",
      "import": "./dist/server.mjs",
      "default": "./dist/server.mjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist/*.d.mts",
    "dist/**/*.mjs",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown --config tsdown.config.mjs --config-loader native",
    "check-types": "tsc --noEmit",
    "prepack": "pnpm run build",
    "pack:dry-run": "npm pack --dry-run",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@11.9.0"
}
